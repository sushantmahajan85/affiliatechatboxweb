# Copy to `.env.local` and fill in values. Restart `next dev` after changes.

# Backend API (must match running server; default server PORT is 2200 unless you use 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LinkedIn: server .env needs FRONTEND_URL=http://localhost:3000 for local dev.
# Use NEXT_PUBLIC_API_URL=http://localhost:8000 and run the API locally, or deploy
# the API with frontend_origin support so Render callbacks can return to localhost.
# After deploy, users must re-authorize LinkedIn (revoke app in Permitted services if needed).

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Web — same project as the Flutter app (see affiliatechatbox/lib/firebase_options.dart → `web`)
# All keys below must be set for Chats to use Firestore like the Android app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# App Check only — create in Google Cloud → Security → reCAPTCHA Enterprise (Score-based Web key).
# Do NOT paste the Authentication v2 key (6Lf...) here; phone-auth reCAPTCHA is auto-provisioned by Firebase.
# Local phone verify: the visible "I'm not a robot" checkbox uses Firebase's Identity Platform v2 key
# (Google Cloud → reCAPTCHA → "Key for Identity Platform reCAPTCHA integration"). Add localhost + 127.0.0.1 there.
# Firebase Console → App Check → Omd_WEb → Register → reCAPTCHA Enterprise.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# LOCAL DEV ONLY: register debug token in Firebase Console → App Check → Web app → Manage debug tokens.
# 1) Set to "true" and restart dev server
# 2) Open browser console, copy the UUID from "App Check debug token: ..."
# 3) Paste that UUID in Firebase Console debug tokens for app 1:603565223533:web:...
# 4) Optional: set this env to that UUID (instead of "true") so it stays stable across reloads
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Dev only: skip real SMS/reCAPTCHA — register test numbers in Firebase Console → Authentication → Phone
NEXT_PUBLIC_FIREBASE_PHONE_TEST_MODE=
# OTP provider: firebase (default on production) | server (your API / Twilio, auto on localhost)
# NEXT_PUBLIC_PHONE_OTP_PROVIDER=firebase
# Default country dial for phone inputs (e.g. 880, 91)
NEXT_PUBLIC_PHONE_DEFAULT_DIAL=
# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
