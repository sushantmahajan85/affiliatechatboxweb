# Copy to `.env.local` and fill in values. Restart `next dev` after changes.

# Backend API (Mongo chat / auth when Firebase env is incomplete)
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Web — same project as the Flutter app (see affiliatechatbox/lib/firebase_options.dart → `web`)
# All keys below must be set for Chats to use Firestore like the Android app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA Enterprise site key — REQUIRED for Firebase phone auth on web SDK v11+
# Firebase Console → Authentication → Settings → reCAPTCHA → Manage reCAPTCHA → Create key (Score-based, Web)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# App Check debug token for LOCAL DEVELOPMENT (do not set in production).
# Set to "true" → copy UUID from browser console → register in Firebase Console → App Check → Debug tokens.
# Or set to the UUID directly once you've registered it.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
